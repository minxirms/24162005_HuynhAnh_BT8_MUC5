type Category {
    id: ID!
    name: String!
    images: String
    products: [Product]
}

type Product {
    id: ID!
    name: String!
    price: Float!
    images: String
    category: Category
}

# Cấu hình DTO phân trang
type ProductPage {
    content: [Product]
    totalPages: Int
    totalElements: Int
    pageNumber: Int
}

type CategoryPage {
    content: [Category]
    totalPages: Int
    totalElements: Int
    pageNumber: Int
}

# Input cho Mutation Product
input ProductInput {
    name: String!
    price: Float!
    images: String
    categoryId: ID!
}

# 1. Các lệnh TRUY VẤN (GET)
type Query {
    getProductsSortedByPrice: [Product]
    getProductsByCategory(categoryId: ID!): [Product]
    searchProducts(keyword: String, page: Int, size: Int): ProductPage
    searchCategories(keyword: String, page: Int, size: Int): CategoryPage
}

# 2. Các lệnh THAY ĐỔI DỮ LIỆU (POST/PUT/DELETE)
type Mutation {
    # CRUD Category
    createCategory(name: String!, images: String): Category
    updateCategory(id: ID!, name: String!, images: String): Category
    deleteCategory(id: ID!): Boolean

    # CRUD Product
    createProduct(input: ProductInput!): Product
    updateProduct(id: ID!, input: ProductInput!): Product
    deleteProduct(id: ID!): Boolean
}